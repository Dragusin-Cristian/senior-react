{
  "name": "@ds.e-udemy/core",
  "version": "1.0.0",
  "main": "index.js",
  "repository": "git@github.com:Dragusin-Cristian/senior-react.git",
  "author": "Dragusin Cristian <dragusincristian609@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "lerna": "^8.2.3"
  },
  "scripts": {
    "refresh-modules": "rm -rf ./**/node_modules && yarn",
    "build": "yarn lerna run build",
    "dev": "yarn lerna run dev",
    "publish": "yarn build && yarn lerna publish",
    "commit": "yarn git-cz"
  },
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "playgrounds/*"
    ],
    "nohoist": [
      "**/normalize-scss"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
