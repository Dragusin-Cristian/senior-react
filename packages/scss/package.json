{
  "name": "@ds.e-udemy/scss",
  "version": "0.1.2",
  "main": "index.js",
  "license": "MIT",
  "dependencies": {
    "normalize-scss": "^8.0.0",
    "sass": "^1.89.2"
  },
  "scripts": {
    "lint": "stylelint './**/*.scss'",
    "lint:fix": "yarn lint --fix",
    "build": "node src/scripts/build.js",
    "dev": "nodemon --watch src --exec yarn build -e scss"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    },
    "lint-staged": {
      "*.scss": "yarn lint:fix"
    }
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "stylelint": "^16.22.0",
    "stylelint-config-prettier": "^9.0.5",
    "stylelint-config-sass-guidelines": "^12.1.0",
    "stylelint-prettier": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "gitHead": "ab2231a294e858708f0f02746d15de0fdb40ab3d"
}
